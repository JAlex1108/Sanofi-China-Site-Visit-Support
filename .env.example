# Copy this file to .env and fill in the values for your setup.
# The application loads .env automatically via python-dotenv.

# ─── Required: trained YOLO weights ────────────────────────────────────────
# Absolute path to best.pt (distributed separately from this repo).
# On Windows use forward slashes or escape backslashes.
YOLO_WEIGHTS_PATH=C:/path/to/weights/best.pt

# ─── Optional: override default camera ID ──────────────────────────────────
# CAMERA_ID=40705473

# ─── Optional: S3 source ───────────────────────────────────────────────────
# Only required when running with `--source s3`. Skip these entirely if you
# always run with `--source <local-folder>` against on-disk videos.
# AWS_PROFILE=your-aws-sso-profile
# S3_VIDEO_BUCKET=your-video-bucket
# S3_VIDEO_PREFIX=your/camera-prefix/

# ─── Optional: single-video FM3 standalone runner ──────────────────────────
# Only needed if running `pipelines/run__infeed_consistency_pipeline.py`
# directly (the main detector pulls helpers from it but doesn't read this).
# INFEED_VIDEO_PATH=C:/path/to/a/single/video.tts
